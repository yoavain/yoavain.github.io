---
layout: layouts/base.njk
---
<article class="post h-entry">
  <header class="post-header">
    <h1 class="post-title p-name">{{ title }}</h1>
    {% if subtitle %}<p class="post-subtitle">{{ subtitle }}</p>{% endif %}
    <p class="post-meta">
      <time class="dt-published" datetime="{{ page.date | htmlDateString }}">
        {{ page.date | readableDate }}
      </time>
      <span aria-hidden="true">&middot;</span>
      <span>{{ content | readingTime }} min read</span>
    </p>
  </header>

  {% if image %}
  <figure class="post-cover">
    <img src="{{ image }}" alt="{{ image_alt }}" width="1600" height="838" loading="eager" decoding="async">
  </figure>
  {% endif %}

  <div class="post-main">
    {% set toc = content | tocItems %}
    {% if toc.length > 1 %}
    <nav class="post-toc" aria-label="On this page">
      <div class="post-toc-inner">
        <p class="post-toc-title">On this page</p>
        <ol>
          {% for item in toc %}<li><a href="#{{ item.id }}">{{ item.text }}</a></li>
          {% endfor %}
        </ol>
      </div>
    </nav>
    {% endif %}
    <div class="post-body e-content">
      {{ content | headingIds | safe }}
    </div>
  </div>

  {% if tags %}
  <footer class="post-tags">
    {% for tag in tags %}{% if tag != "posts" %}<span class="tag">{{ tag }}</span>{% endif %}{% endfor %}
  </footer>
  {% endif %}

  <nav class="post-nav">
    <a href="/">&larr; All writing</a>
  </nav>
</article>
