---
layout: layouts/base.njk
eleventyExcludeFromCollections: true
---
{%- set t = i18n[lang or metadata.language] or i18n.en -%}
<section class="intro">
  <h1>{{ metadata.title }}</h1>
  <p class="tagline">{{ metadata.tagline }}</p>
</section>

<section class="post-list" aria-label="Posts">
  {%- set posts = collections.posts | reverse -%}
  {%- if posts | length -%}
  <ul>
    {%- for post in posts %}
    <li{% if post.data.lang == "he" %} lang="he" dir="rtl"{% endif %}>
      <article class="post-card">
        {% if post.data.image %}<img class="post-card-thumb" src="{{ post.data.image }}" alt="" width="1600" height="838" loading="lazy" decoding="async">{% endif %}
        <div class="post-card-text">
          <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
          <p class="post-meta">
            <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate(post.data.lang) }}</time>
          </p>
          {% if post.data.subtitle %}<p class="post-card-summary">{{ post.data.subtitle }}</p>{% endif %}
        </div>
      </article>
    </li>
    {%- endfor %}
  </ul>
  {%- else -%}
  <p>{{ t.nothing }}</p>
  {%- endif -%}
</section>
